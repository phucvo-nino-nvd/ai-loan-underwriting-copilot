# Copy to .env.local and fill in. Both values are public (they ship in the browser bundle).

# Clerk dashboard > API Keys > Publishable key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Where the local frontend sends /api requests. Comment this out to use a
# backend running on your machine (defaults to http://localhost:8000).
# For the deployed backend, paste the output of:
#   cd terraform/6_frontend && terraform output -raw cloudfront_url
# Before phase 6 exists, use terraform/5_api output api_function_url instead;
# after phase 6 that URL is AWS_IAM-signed and rejects the browser.
# Ignored when the site is served from CloudFront: production uses relative /api/*.
#NEXT_PUBLIC_API_URL=https://xxxxxxxxxxxxxx.cloudfront.net
