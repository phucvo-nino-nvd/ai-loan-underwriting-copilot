# Environment files — every variant holds real credentials, only the templates are committed
.env
.env.*
!.env.example
!.env.local.example

# Python virtual environments
.venv/
venv/
env/

# Python bytecode and caches
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Build artifacts
build/
dist/
*.egg-info/
*.egg

# Project generated artifacts
output/
backend/vector_db/
backend/memory/

# Frontend dependencies and build output
node_modules/
.next/
out/
dist/

# OS/editor files
.DS_Store
.idea/
.vscode/
.omo/
.codegraph/
.claude/settings.local.json

# Terraform files — .terraform.lock.hcl is deliberately not ignored, it pins the provider versions
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.backup
crash*.log
.terraform/
.terraform.tfstate.lock.info