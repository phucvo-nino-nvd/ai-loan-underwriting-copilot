# Aluci - Environment Variables
# Copy this file to .env and fill in your actual values.
# Sections match guides/<n>_*.md and terraform/<n>_*. Optional keys (code has a
# default, or a terraform output is read instead) are commented out - uncomment
# only to override.
# Frontend variables are NOT here: see frontend/.env.local.example.

# ============================================================
# PART 0: Initial Setup (guides/0_permissions.md)
# ============================================================
# Your AWS Account ID (aws sts get-caller-identity --query Account --output text)
# Not read by code; the guides use it to build ECR URIs and IAM policies.
AWS_ACCOUNT_ID=123456789012

# Region for all infrastructure. Every script and the API read this first.
DEFAULT_AWS_REGION=ap-southeast-1

# Optional: fallback used only when DEFAULT_AWS_REGION is unset
# AWS_REGION=ap-southeast-1

# ============================================================
# PART 1: Classifier (terraform/1_sagemaker)
# ============================================================
# Runtime: SageMaker endpoint the API invokes (backend/api/main.py) - required
CLASSIFIER_ENDPOINT_NAME=aluci-classifier-endpoint

# Test: backend/classifier/test_api.py
SAGEMAKER_ENDPOINT=aluci-classifier-endpoint

# Optional: alias for test_api.py (used when SAGEMAKER_ENDPOINT is unset)
# CLASSIFIER_ENDPOINT=aluci-classifier-endpoint

# Optional: backend/classifier/deploy.py (when the terraform output is not readable)
# CLASSIFIER_ECR_REPOSITORY_URL=

# ============================================================
# PART 2: Ingestion Pipeline (terraform/2_ingestion)
# ============================================================
# Runtime: S3 Vectors bucket holding policy docs (backend/ingest/*,
# backend/copilot/tools.py) - required
VECTOR_BUCKET=aluci-vectors

# Runtime: ingest Lambda the API invokes to re-index policies after an upload
# (backend/api/main.py). Empty = the API skips re-ingestion and logs a warning.
INGEST_LAMBDA_NAME=aluci-ingest

# Optional: override default "policy-docs"
# INDEX_NAME=policy-docs

# Optional: backend/ingest/deploy.py (when the terraform output is not readable)
# INGEST_ECR_REPOSITORY_URL=

# ============================================================
# PART 3: Copilot Service (terraform/3_copilot)
# ============================================================
# Runtime: LLM + embeddings (backend/copilot/prompt.py, tools.py) - required
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: override default "https://openrouter.ai/api/v1"
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: override the embedding model defined in code
# OPENROUTER_EMBEDDING_MODEL=

# Optional: backend/copilot/deploy.py (when the terraform output is not readable)
# COPILOT_ECR_REPOSITORY_URL=

# LangSmith tracing for the copilot. Read by the langsmith SDK itself, not by our
# code, so it traces whatever LangChain call you run locally - including a local
# backend/ingest run, which is harmless. Only the copilot Lambda is traced when
# deployed; its copies of these values live in terraform/3_copilot/terraform.tfvars.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=aluci

# Optional: override the SDK default (https://api.smith.langchain.com)
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ============================================================
# PART 4: Database (terraform/4_database)
# ============================================================
# Runtime: Aurora Data API access (backend/database/src/client.py) - required.
# Both ARNs change whenever phase 4 is destroyed and recreated.
AURORA_CLUSTER_ARN=arn:aws:rds:...
AURORA_SECRET_ARN=arn:aws:secretsmanager:...

# Optional: override default "aluci"
AURORA_DATABASE=aluci

# ============================================================
# PART 5: API (terraform/5_api)
# ============================================================
# Runtime: API relays SSE to the Copilot Lambda (backend/api/main.py) - required
COPILOT_URL=https://...

# Runtime: Clerk JWT validation (backend/api/main.py) - required
CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json

# Optional: override default "http://localhost:3000" (CORS)
# CORS_ORIGINS=http://localhost:3000

# Optional: backend/api/package_docker.py (when the terraform output is not readable)
# API_ECR_REPOSITORY_URL=

# ============================================================
# PART 6: Frontend (terraform/6_frontend)
# ============================================================
# Optional: target bucket for frontend/deploy.py. Normally read from the
# terraform output; set it only if that is not readable.
# FRONTEND_BUCKET=aluci-frontend-123456789012